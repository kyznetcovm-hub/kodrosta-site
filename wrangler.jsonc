{
  "name": "kodrosta-site",
  "compatibility_date": "2026-08-15",
  "main": "src/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Без этого Cloudflare пытается сначала сматчить /turizm/<slug> как статический
    // файл/редирект и не доходит до Worker'а — из-за этого ссылки на конкретные
    // мероприятия (handleTurizmEventPage в src/index.js) не открывались.
    "run_worker_first": ["/turizm/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kodrosta-engagement",
      "database_id": "6edb94c1-238e-4643-9300-36f51a463c57"
    }
  ],
  "vars": {
    "ADMIN_USERNAMES": "mytolstoy,Kodrosta",
    "COOLING_WARN_DAYS": "45",
    "COOLING_CRITICAL_DAYS": "90",
    "RESIDENTS_CHAT_ID": "-1002274713400",
    "GOOGLE_SHEET_ID": "1vfDKwTRVH3FIcaNZIK_JeBX5CRJH9iDsI7iyN1nqnZE",
    "SUBSCRIPTION_ALERT_USERNAME": "Kodrosta"
  },
  "triggers": {
    // 03:00 UTC = 06:00 по Москве/Казани — раз в сутки синхронизация с гугл-таблицей
    // 05:00 UTC = 08:00 по Москве/Казани — регламент продления; 08:15/08:30 — повтор при сбое
    // Успешно доставленные ежедневный отчёт и ФИНАЛ повторно не отправляются.
    // 07:00 UTC пн = 10:00 по Москве/Казани — еженедельная сводка по Яндекс.Метрике
    // 06:00 UTC 1-го числа = 09:00 по Москве/Казани — отчёт за прошедший месяц
    "crons": ["0 3 * * *", "0,15,30 5 * * *", "0 7 * * 1", "0 6 1 * *"]
  }
}
